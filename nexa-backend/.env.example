APP_NAME="Nexa Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL phpMyAdmin lokal atau MySQL/PostgreSQL Online)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexa_digital
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CORS_ALLOWED_ORIGINS=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# SMTP Email (.@ domain resmi / SMTP relay)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mail.domainkamu.com
MAIL_PORT=587
MAIL_USERNAME=billing@domainkamu.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="billing@domainkamu.com"
MAIL_FROM_NAME="${APP_NAME}"

# Cronjob Invoice Reminder (pengecekan berjalan tiap 5 menit di scheduler)
INVOICE_REMINDER_INITIAL_DELAY_MINUTES=5
INVOICE_REMINDER_COOLDOWN_MINUTES=1440
INVOICE_REMINDER_DAYS_BEFORE_DUE=30
INVOICE_REMINDER_MAX_COUNT=5

# Midtrans Payment Gateway (Sandbox / Production)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

VITE_APP_NAME="${APP_NAME}"
